<Page
    x:Class="StartSet.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gui="using:StartSet.Infrastructure.Gui"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,24,28,24">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- ═══ App Info Header ═══ -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,4">
                <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />

                <TextBlock Text="Managed State Keeper"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Runs payloads at boot, at login and on demand, from C:\ProgramData\ManagedState."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="500"
                           TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/windowsadmins/startset#readme" />
                    <HyperlinkButton Content="Report Issue"
                                     NavigateUri="https://github.com/windowsadmins/startset/issues" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══ Policy line: a grayed-out control is one policy sets ═══ -->
            <StackPanel Orientation="Horizontal" Spacing="6"
                        Visibility="{x:Bind ViewModel.HasPolicySettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Settings shown in gray have been configured by a policy."
                           Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ═══ Save row: edits are held until Save, which asks UAC when not elevated ═══ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PendingSummary, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="SaveStatus" Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="WrapWholeWords" Visibility="Collapsed" />
                </StackPanel>
                <Button Grid.Column="1" Content="Discard" Click="Discard_Click"
                        Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InvertBool}}"
                        ToolTipService.ToolTip="Drop the unsaved changes" />
                <Button Grid.Column="2" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InvertBool}}"
                        ToolTipService.ToolTip="Save to this device's machine settings (asks for administrator approval)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SaveShield" Glyph="&#xEA18;" FontSize="14" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══ Settings cards, one per group, built from the setting list ═══ -->
            <StackPanel x:Name="Cards" Spacing="16" />

            <!-- ═══ Services: what the installer put on this device, read-only ═══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE912;" FontSize="20" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Services" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="RefreshServices_Click" Padding="8,4"
                                ToolTipService.ToolTip="Check the services again">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="State" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Last result" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Starts" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gui:FootprintStatus">
                                <Grid ColumnSpacing="16" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" ToolTipService.ToolTip="{x:Bind Description}">
                                        <TextBlock Text="{x:Bind FriendlyName}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind NameAndKind}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind State}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind LastResult}" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Trigger}" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
