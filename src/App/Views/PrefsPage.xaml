<Page
    x:Class="StartSet.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,24,28,24">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- ═══ App Info Header ═══ -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,4">
                <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />

                <TextBlock Text="Managed State Keeper"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Runs payloads at boot, at login and on demand, from C:\ProgramData\ManagedState."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="500"
                           TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/windowsadmins/startset#readme" />
                    <HyperlinkButton Content="Report Issue"
                                     NavigateUri="https://github.com/windowsadmins/startset/issues" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══ Read-only banner: settings live in HKLM, so editing needs elevation ═══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12"
                    Visibility="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                                   Text="Settings are read-only. Unlock to change them (requires administrator)." />
                        <Button Grid.Column="2" x:Name="UnlockButton" Click="UnlockButton_Click"
                                ToolTipService.ToolTip="Relaunch as administrator to edit settings">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                <TextBlock Text="Unlock" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.UnlockError, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasUnlockError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Running as administrator. Changes save to HKLM\SOFTWARE\StartSet\Settings."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="SaveStatus" HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />

            <!-- ═══ Settings cards, one per group, built from the setting list ═══ -->
            <StackPanel x:Name="Cards" Spacing="16" />

        </StackPanel>
    </ScrollViewer>
</Page>
