<Page
    x:Class="StartSet.App.Views.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Run choices: one card per run ═══ -->
        <Grid x:Name="RunCards" Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- ═══ Run Control Bar ═══ -->
        <Grid Grid.Row="1" Padding="24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StopButton" Grid.Column="0" Click="StopButton_Click" IsEnabled="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="DebugToggle" Content="Debug" Checked="DebugToggle_Changed"
                          Unchecked="DebugToggle_Changed" />
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>

            <!-- Right-aligned status -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="RunningProgress" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="RunningLabel" Text="Running..."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Visibility="Collapsed" />

                <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon x:Name="StatusIcon" FontSize="16" />
                    <TextBlock x:Name="StatusText" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ Progress Bar + Payload Info ═══ -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Spacing="6" Padding="24,0,24,12"
                    Visibility="Collapsed">
            <ProgressBar x:Name="StepProgress" IsIndeterminate="True"
                         Height="4" CornerRadius="2" />
            <Grid>
                <TextBlock x:Name="StepItemLabel"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StepCountLabel"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- ═══ Error / Success Banner ═══ -->
        <InfoBar x:Name="ResultBanner" Grid.Row="3"
                 IsOpen="False" IsClosable="True" Margin="24,0,24,8" />

        <MenuFlyoutSeparator Grid.Row="4" />

        <!-- ═══ Console Output ═══ -->
        <Grid Grid.Row="5">
            <ScrollViewer x:Name="ConsoleScroller" Padding="12"
                          Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                <RichTextBlock x:Name="ConsoleOutput" IsTextSelectionEnabled="True"
                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                               TextWrapping="Wrap" Padding="4,0" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE756;" FontSize="48"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                <TextBlock Text="No Run Yet" Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Output streams here while a run is in progress."
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
